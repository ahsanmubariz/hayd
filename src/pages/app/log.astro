---
import AppShell from '@/layouts/AppShell.astro';
import { Card, CardHeader, CardContent } from '@/components/ui/card';
import { Alert } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import { addPeriodLog, addDailyStatus, editPeriodLog, editDailyStatus } from '@/lib/modules/cycles/service';
import { getDailyStatusLog, listPeriodLogs } from '@/lib/modules/cycles/repository';
import { todayIso } from '@/lib/utils/dates';
import { translate } from '@/lib/i18n/use-translation';
import { getCsrfToken, validateCsrf } from '@/lib/auth/csrf';

export const prerender = false;

const csrfToken = getCsrfToken(Astro);

const user = Astro.locals.user!;
const url = new URL(Astro.request.url);
const logDate = url.searchParams.get('date') ?? todayIso();
const tab = url.searchParams.get('tab') ?? 'status';

let message = '';
let messageType: 'success' | 'error' = 'success';
let errors: Record<string, string> = {};

const existingStatus = await getDailyStatusLog(user.id, logDate);
const allPeriods = await listPeriodLogs(user.id);
const existingPeriod = allPeriods.find(p => p.start_date <= logDate && p.end_date >= logDate) ?? null;

function formatDateLong(iso: string): string {
  if (!iso) return iso;
  const d = new Date(iso + 'T12:00:00');
  return d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  if (!validateCsrf(Astro, Astro.request, formData)) {
    message = translate('log.something_wrong');
    messageType = 'error';
  } else {
    const action = String(formData.get('action') ?? '');
    const formDate = String(formData.get('logDate') ?? logDate);

    try {
      if (action === 'period') {
        const startDate = String(formData.get('startDate') ?? '');
        const endDate = String(formData.get('endDate') ?? '');
        const flowIntensity = String(formData.get('flowIntensity') ?? '');
        const notes = String(formData.get('notes') ?? '');
        if (existingPeriod) {
          await editPeriodLog(user.id, existingPeriod.id, { startDate, endDate, flowIntensity, notes });
          message = translate('log.period_updated');
        } else {
          await addPeriodLog(user.id, { startDate, endDate, flowIntensity, notes });
          message = translate('log.period_saved');
        }
        messageType = 'success';
      } else {
        const bleedingStatus = String(formData.get('bleedingStatus') ?? '');
        const painLevel = String(formData.get('painLevel') ?? '');
        const mood = String(formData.get('mood') ?? '');
        const energyLevel = String(formData.get('energyLevel') ?? '');
        const notes = String(formData.get('notes') ?? '');
        if (existingStatus) {
          await editDailyStatus(user.id, formDate, {
            bleedingStatus,
            painLevel: painLevel ? Number(painLevel) : undefined,
            mood,
            energyLevel: energyLevel ? Number(energyLevel) : undefined,
            notes,
          });
          message = translate('log.daily_updated');
        } else {
          await addDailyStatus(user.id, {
            logDate: formDate,
            bleedingStatus,
            painLevel: painLevel ? Number(painLevel) : undefined,
            mood,
            energyLevel: energyLevel ? Number(energyLevel) : undefined,
            notes,
          });
          message = translate('log.daily_saved');
        }
        messageType = 'success';
      }
    } catch (err) {
      if (err && typeof err === 'object' && 'fieldErrors' in err) {
        errors = (err as { fieldErrors: Record<string, string> }).fieldErrors;
        message = translate('log.fix_errors');
      } else {
        message = translate('log.something_wrong');
      }
      messageType = 'error';
    }
  }
}

const moods = [
  { key: 'log.happy', val: 'happy' },
  { key: 'log.calm', val: 'calm' },
  { key: 'log.neutral', val: 'neutral' },
  { key: 'log.sad', val: 'sad' },
  { key: 'log.anxious', val: 'anxious' },
  { key: 'log.irritable', val: 'irritable' },
  { key: 'log.energetic', val: 'energetic' },
  { key: 'log.tired', val: 'tired' },
  { key: 'log.stressed', val: 'stressed' },
  { key: 'log.content', val: 'content' },
  { key: 'log.frustrated', val: 'frustrated' },
  { key: 'log.hopeful', val: 'hopeful' },
];
---

<AppShell
  title="Log Entry"
  activeRoute="log"
  headerTitle={existingStatus || existingPeriod ? translate('log.edit_entry') : translate('log.new_entry')}
  headerSubtitle={formatDateLong(logDate)}
  showBack
  backHref="/app"
>
  <div class="space-y-4 p-4 pb-8">
    {message && (
      <Alert variant={messageType === 'error' ? 'error' : 'success'}>{message}</Alert>
    )}

    {/* Tab Toggle Pill */}
    <div class="flex items-center rounded-2xl border border-border bg-card p-1.5 shadow-2xs">
      <button
        type="button"
        id="tab-status"
        onclick="switchTab('status')"
        class={`flex-1 rounded-xl py-2 text-xs font-semibold tracking-tight transition-all duration-150 ${
          tab === 'status' ? 'bg-primary text-primary-foreground shadow-xs' : 'text-muted-foreground hover:text-foreground'
        }`}
      >
        {translate('log.daily_status_tab')}
      </button>
      <button
        type="button"
        id="tab-period"
        onclick="switchTab('period')"
        class={`flex-1 rounded-xl py-2 text-xs font-semibold tracking-tight transition-all duration-150 ${
          tab === 'period' ? 'bg-primary text-primary-foreground shadow-xs' : 'text-muted-foreground hover:text-foreground'
        }`}
      >
        {translate('log.period_tab')}
      </button>
    </div>

    {/* Daily Status Form */}
    <div id="form-status" class={tab === 'status' ? 'space-y-4' : 'hidden'}>
      <form method="POST">
        <input type="hidden" name="action" value="status" />
        <input type="hidden" name="_csrf" value={csrfToken} />
        
        <Card className="space-y-4 p-5">
          <!-- Date Selector -->
          <div class="flex flex-col gap-1.5">
            <label for="logDate-status" class="text-xs font-medium text-foreground tracking-tight">{translate('log.date')}</label>
            <input
              type="date"
              id="logDate-status"
              name="logDate"
              value={logDate}
              onchange="window.location.href='/app/log?date='+this.value"
              class="h-10 w-full rounded-xl border border-border bg-card px-3.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
            />
          </div>

          <!-- Bleeding Status -->
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-medium text-foreground tracking-tight">{translate('log.bleeding_status')}</label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              {[
                { val: '', label: 'None' },
                { val: 'spotting', label: translate('log.spotting') },
                { val: 'light', label: translate('log.light') },
                { val: 'medium', label: translate('log.medium') },
                { val: 'heavy', label: translate('log.heavy') },
              ].filter(x => x.val).map((opt) => (
                <label class="relative flex items-center justify-center rounded-xl border border-border bg-card p-2.5 text-xs font-medium cursor-pointer hover:bg-muted/60 transition-all has-checked:border-primary has-checked:bg-primary/10 has-checked:text-primary">
                  <input
                    type="radio"
                    name="bleedingStatus"
                    value={opt.val}
                    checked={existingStatus?.bleeding_status === opt.val}
                    class="sr-only"
                  />
                  <span>{opt.label}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Pain Level Slider (0-10) -->
          <div class="flex flex-col gap-1.5">
            <div class="flex items-center justify-between">
              <label for="painRange" class="text-xs font-medium text-foreground tracking-tight">{translate('log.pain_level')}</label>
              <span id="painDisplay" class="text-xs font-bold text-primary">
                {existingStatus?.pain_level != null ? `${existingStatus.pain_level}/10` : '0/10'}
              </span>
            </div>
            <input
              type="range"
              id="painRange"
              name="painLevel"
              min="0"
              max="10"
              value={existingStatus?.pain_level ?? 0}
              oninput="document.getElementById('painDisplay').textContent = this.value + '/10'"
              class="w-full accent-primary h-2 bg-muted rounded-lg cursor-pointer"
            />
            <p class="text-[11px] text-muted-foreground">{translate('log.pain_help')}</p>
          </div>

          <!-- Energy Level Slider (0-10) -->
          <div class="flex flex-col gap-1.5">
            <div class="flex items-center justify-between">
              <label for="energyRange" class="text-xs font-medium text-foreground tracking-tight">{translate('log.energy_level')}</label>
              <span id="energyDisplay" class="text-xs font-bold text-amber">
                {existingStatus?.energy_level != null ? `${existingStatus.energy_level}/10` : '5/10'}
              </span>
            </div>
            <input
              type="range"
              id="energyRange"
              name="energyLevel"
              min="0"
              max="10"
              value={existingStatus?.energy_level ?? 5}
              oninput="document.getElementById('energyDisplay').textContent = this.value + '/10'"
              class="w-full accent-amber h-2 bg-muted rounded-lg cursor-pointer"
            />
            <p class="text-[11px] text-muted-foreground">{translate('log.energy_help')}</p>
          </div>

          <!-- Mood Pebble Selector -->
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-medium text-foreground tracking-tight">{translate('log.mood')}</label>
            <div class="flex flex-wrap gap-1.5">
              {moods.map((m) => (
                <label class="relative flex items-center rounded-full border border-border bg-card px-3 py-1.5 text-xs font-medium cursor-pointer hover:bg-muted/60 transition-all has-checked:border-accent has-checked:bg-accent/15 has-checked:text-foreground">
                  <input
                    type="radio"
                    name="mood"
                    value={m.val}
                    checked={existingStatus?.mood?.toLowerCase() === m.val}
                    class="sr-only"
                  />
                  <span>{translate(m.key as any)}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Notes -->
          <div class="flex flex-col gap-1.5">
            <label for="notes-status" class="text-xs font-medium text-foreground tracking-tight">{translate('log.notes')}</label>
            <textarea
              id="notes-status"
              name="notes"
              rows={3}
              maxlength={500}
              placeholder={translate('log.notes_placeholder')}
              class="w-full rounded-xl border border-border bg-card px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:ring-2 focus:ring-ring resize-none shadow-xs"
            >{existingStatus?.notes ?? ''}</textarea>
          </div>

          <div class="flex gap-2.5 pt-2">
            <a href="/app" class="flex-1">
              <Button type="button" variant="outline" className="w-full h-10">{translate('log.cancel')}</Button>
            </a>
            <Button type="submit" className="flex-1 h-10 shadow-xs">
              {existingStatus ? translate('log.update') : translate('log.save')}
            </Button>
          </div>
        </Card>
      </form>
    </div>

    {/* Period Form */}
    <div id="form-period" class={tab === 'period' ? 'space-y-4' : 'hidden'}>
      <form method="POST">
        <input type="hidden" name="action" value="period" />
        <input type="hidden" name="_csrf" value={csrfToken} />
        
        <Card className="space-y-4 p-5">
          <!-- Start Date -->
          <div class="flex flex-col gap-1.5">
            <label for="startDate" class="text-xs font-medium text-foreground tracking-tight">{translate('log.start_date')}</label>
            <input
              type="date"
              id="startDate"
              name="startDate"
              required
              value={existingPeriod?.start_date ?? logDate}
              class="h-10 w-full rounded-xl border border-border bg-card px-3.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
            />
          </div>

          <!-- End Date -->
          <div class="flex flex-col gap-1.5">
            <label for="endDate" class="text-xs font-medium text-foreground tracking-tight">{translate('log.end_date')}</label>
            <input
              type="date"
              id="endDate"
              name="endDate"
              required
              value={existingPeriod?.end_date ?? logDate}
              class="h-10 w-full rounded-xl border border-border bg-card px-3.5 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
            />
          </div>

          <!-- Flow Intensity Selector -->
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-medium text-foreground tracking-tight">{translate('log.flow_intensity')}</label>
            <div class="grid grid-cols-3 gap-2">
              {[
                { val: 'light', label: translate('log.light') },
                { val: 'medium', label: translate('log.medium') },
                { val: 'heavy', label: translate('log.heavy') },
              ].map((opt) => (
                <label class="relative flex items-center justify-center rounded-xl border border-border bg-card p-2.5 text-xs font-medium cursor-pointer hover:bg-muted/60 transition-all has-checked:border-primary has-checked:bg-primary/10 has-checked:text-primary">
                  <input
                    type="radio"
                    name="flowIntensity"
                    value={opt.val}
                    checked={existingPeriod?.flow_intensity === opt.val}
                    class="sr-only"
                  />
                  <span>{opt.label}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Notes -->
          <div class="flex flex-col gap-1.5">
            <label for="notes-period" class="text-xs font-medium text-foreground tracking-tight">{translate('log.notes')}</label>
            <textarea
              id="notes-period"
              name="notes"
              rows={3}
              maxlength={500}
              placeholder={translate('log.notes_placeholder')}
              class="w-full rounded-xl border border-border bg-card px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:ring-2 focus:ring-ring resize-none shadow-xs"
            >{existingPeriod?.notes ?? ''}</textarea>
          </div>

          <div class="flex gap-2.5 pt-2">
            <a href="/app" class="flex-1">
              <Button type="button" variant="outline" className="w-full h-10">{translate('log.cancel')}</Button>
            </a>
            <Button type="submit" className="flex-1 h-10 shadow-xs">
              {existingPeriod ? translate('log.update') : translate('log.save')}
            </Button>
          </div>
        </Card>
      </form>
    </div>
  </div>

  <script is:inline>
    function switchTab(t) {
      document.getElementById('form-status').classList.toggle('hidden', t !== 'status');
      document.getElementById('form-period').classList.toggle('hidden', t !== 'period');
      
      const tabStatus = document.getElementById('tab-status');
      const tabPeriod = document.getElementById('tab-period');
      
      if (t === 'status') {
        tabStatus.className = 'flex-1 rounded-xl py-2 text-xs font-semibold tracking-tight transition-all duration-150 bg-primary text-primary-foreground shadow-xs';
        tabPeriod.className = 'flex-1 rounded-xl py-2 text-xs font-semibold tracking-tight transition-all duration-150 text-muted-foreground hover:text-foreground';
      } else {
        tabPeriod.className = 'flex-1 rounded-xl py-2 text-xs font-semibold tracking-tight transition-all duration-150 bg-primary text-primary-foreground shadow-xs';
        tabStatus.className = 'flex-1 rounded-xl py-2 text-xs font-semibold tracking-tight transition-all duration-150 text-muted-foreground hover:text-foreground';
      }
      
      const url = new URL(window.location);
      url.searchParams.set('tab', t);
      window.history.replaceState({}, '', url);
    }
  </script>
</AppShell>
