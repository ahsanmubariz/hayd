---
import AppShell from '@/layouts/AppShell.astro';
import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/card';
import { CycleStatsCards } from '@/components/app/cycle-stats-cards';
import { findPeriodLogs } from '@/lib/db/client';
import { daysBetween } from '@/lib/utils/dates';
import { translate } from '@/lib/i18n/use-translation';

export const prerender = false;

const user = Astro.locals.user!;
const periodLogs = await findPeriodLogs(user.id);

const cycleLengths: number[] = [];
for (let i = 1; i < periodLogs.length; i++) {
  const len = daysBetween(periodLogs[i - 1].start_date, periodLogs[i].start_date);
  if (len >= 15 && len <= 90) cycleLengths.push(len);
}

const avgCycle = cycleLengths.length > 0 ? Math.round(cycleLengths.reduce((a, b) => a + b, 0) / cycleLengths.length) : undefined;
const periodLengths = periodLogs.map((l) => daysBetween(l.start_date, l.end_date) + 1);
const avgPeriod = periodLengths.length > 0 ? Math.round(periodLengths.reduce((a, b) => a + b, 0) / periodLengths.length) : undefined;

const cv = cycleLengths.length > 1
  ? Math.sqrt(cycleLengths.reduce((acc, l) => acc + (l - (avgCycle ?? 28)) ** 2, 0) / cycleLengths.length) / (avgCycle ?? 28)
  : 0;
const trendLabel = cv > 0.2 ? 'More variable than usual' : cycleLengths.length > 1 ? 'Consistent' : 'Not enough data';
---

<AppShell title="History" activeRoute="home" headerTitle={translate('history.title')} headerSubtitle={translate('history.subtitle')}>
  <div class="space-y-4 p-4 pb-8 select-none">
    {periodLogs.length > 0 && (
      <CycleStatsCards
        averageCycleLength={avgCycle}
        averagePeriodLength={avgPeriod}
        totalCycles={periodLogs.length}
        trendLabel={trendLabel}
        client:load
      />
    )}

    <Card>
      <CardHeader className="p-5 pb-2">
        <CardTitle className="text-sm font-semibold tracking-tight">{translate('history.period_log')}</CardTitle>
      </CardHeader>
      <CardContent className="p-5 pt-1">
        {periodLogs.length === 0 ? (
          <div class="flex flex-col items-center justify-center gap-2 rounded-2xl border border-dashed border-border/80 bg-card p-8 text-center">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-muted/80 border border-border text-muted-foreground mb-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="3" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
            </div>
            <p class="text-sm font-semibold text-foreground">{translate('history.no_periods')}</p>
            <p class="text-xs text-muted-foreground max-w-xs">{translate('history.no_periods_desc')}</p>
          </div>
        ) : (
          <ul class="divide-y divide-border/60">
            {[...periodLogs].reverse().map((log) => (
              <li class="flex items-center justify-between py-3.5 first:pt-1 last:pb-0">
                <div class="flex items-center gap-3">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-2xl bg-primary/10 text-primary border border-primary/25 shadow-2xs">
                    <span class="h-2 w-2 rounded-full bg-primary" />
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-foreground tracking-tight">
                      {new Date(log.start_date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                      {log.start_date !== log.end_date && (
                        <span> - {new Date(log.end_date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
                      )}
                    </p>
                    <p class="text-[11px] text-muted-foreground mt-0.5 font-medium">
                      <span class="tabular-nums">{daysBetween(log.start_date, log.end_date) + 1}</span> {translate('history.days')}
                      {log.flow_intensity ? <span> · <span class="capitalize">{log.flow_intensity}</span></span> : ''}
                    </p>
                  </div>
                </div>
                <span class="text-xs font-semibold text-muted-foreground/80 bg-muted/60 px-2.5 py-1 rounded-xl border border-border/50 tabular-nums shadow-2xs">
                  {new Date(log.start_date + 'T12:00:00').getFullYear()}
                </span>
              </li>
            ))}
          </ul>
        )}
      </CardContent>
    </Card>
  </div>
</AppShell>

