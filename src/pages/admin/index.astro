---
import AdminShell from '@/layouts/AdminShell.astro';
import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/card';
import { KpiCards } from '@/components/admin/kpi-cards';
import { listUsers } from '@/lib/modules/users/repository';

export const prerender = false;

const user = Astro.locals.user!;
const users = await listUsers();
const now = Date.now();
const thirtyDaysMs = 1000 * 60 * 60 * 24 * 30;

const totalUsers = users.length;
const activeUsers = users.filter((u) => u.status === 'active').length;
const inactiveUsers = users.filter((u) => u.status === 'inactive').length;
const newUsers = users.filter((u) => now - new Date(u.created_at).getTime() < thirtyDaysMs).length;
---

<AdminShell title="Dashboard" activeRoute="dashboard">
  <div class="space-y-6 select-none">
    <div>
      <h1 class="text-xl font-bold text-foreground tracking-tight">Command Center</h1>
      <p class="text-xs text-muted-foreground mt-0.5">Telemetry & system control for {user.email}</p>
    </div>

    <KpiCards
      totalUsers={totalUsers}
      activeUsers={activeUsers}
      inactiveUsers={inactiveUsers}
      newUsers={newUsers}
      client:load
    />

    <Card>
      <CardHeader className="p-5 pb-2">
        <CardTitle className="text-sm font-semibold tracking-tight">Quick Operations</CardTitle>
      </CardHeader>
      <CardContent className="p-5 pt-1">
        <div class="flex flex-wrap gap-2.5">
          <a href="/admin/users/new" class="inline-flex items-center gap-1.5 rounded-2xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow-xs hover:brightness-105 active:scale-[0.98] transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14M5 12h14"/>
            </svg>
            Add user
          </a>
          <a href="/admin/users" class="inline-flex items-center rounded-2xl border border-border bg-card px-4 py-2 text-xs font-semibold text-foreground shadow-2xs hover:bg-muted/70 active:scale-[0.98] transition-all">
            Manage users
          </a>
          <a href="/admin/audit-logs" class="inline-flex items-center rounded-2xl border border-border bg-card px-4 py-2 text-xs font-semibold text-foreground shadow-2xs hover:bg-muted/70 active:scale-[0.98] transition-all">
            View audit logs
          </a>
        </div>
      </CardContent>
    </Card>
  </div>
</AdminShell>

