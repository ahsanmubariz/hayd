---
import AppShell from '@/layouts/AppShell.astro';
import { Card, CardContent } from '@/components/ui/card';
import { PredictionForecastView } from '@/components/app/prediction-forecast-view';
import { Alert } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import { findLatestPrediction, findPeriodLogs } from '@/lib/db/client';
import { recomputeAndStore } from '@/lib/modules/predictions/service';
import { todayIso } from '@/lib/utils/dates';
import { translate } from '@/lib/i18n/use-translation';
import { getCsrfToken, validateCsrf } from '@/lib/auth/csrf';

export const prerender = false;

const csrfToken = getCsrfToken(Astro);
const user = Astro.locals.user!;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  if (!validateCsrf(Astro, Astro.request, formData)) {
    return Astro.redirect('/app/predictions');
  }
  await recomputeAndStore(user.id);
  return Astro.redirect('/app/predictions');
}

const prediction = await findLatestPrediction(user.id);
const periodLogs = await findPeriodLogs(user.id);
const today = todayIso();
---

<AppShell title="Predictions" activeRoute="predictions" headerTitle={translate('nav.predictions')} headerSubtitle={translate('predictions.based_on')}>
  <div class="space-y-4 p-4 pb-12 select-none">
    {periodLogs.length === 0 ? (
      <Alert variant="info">
        <strong class="block mb-0.5 font-semibold text-foreground">{translate('predictions.no_data')}</strong>
        {translate('predictions.no_data_desc')}
      </Alert>
    ) : periodLogs.length < 3 ? (
      <Alert variant="warning">
        <strong class="block mb-0.5 font-semibold text-foreground">{translate('predictions.limited_data')}</strong>
        {translate('predictions.limited_data_desc', periodLogs.length)}
      </Alert>
    ) : null}

    {prediction ? (
      <PredictionForecastView
        today={today}
        predictedNextPeriodDate={prediction.predicted_next_period_date}
        predictedOvulationDate={prediction.predicted_ovulation_date ?? undefined}
        predictedFertileStart={prediction.predicted_fertile_start ?? undefined}
        predictedFertileEnd={prediction.predicted_fertile_end ?? undefined}
        averageCycleLengthUsed={prediction.average_cycle_length_used}
        averagePeriodLengthUsed={prediction.average_period_length_used}
        cyclesConsidered={prediction.cycles_considered}
        confidenceBand={prediction.confidence_band}
        confidenceReason={prediction.confidence_reason}
        algorithmVersion={prediction.algorithm_version}
        client:load
      />
    ) : (
      <Card className="border-border/80 shadow-sm shadow-stone-900/5">
        <CardContent className="py-12 text-center flex flex-col items-center">
          <div className="mb-3 flex h-14 w-14 items-center justify-center rounded-3xl bg-primary/10 text-primary border border-primary/20 shadow-xs">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 3a9 9 0 0 1 0 18v-18z" fill="currentColor" fillOpacity="0.15" />
            </svg>
          </div>
          <p className="text-sm font-bold text-foreground mb-1">{translate('predictions.no_prediction')}</p>
          <p className="text-xs text-muted-foreground max-w-xs leading-relaxed">{translate('predictions.log_to_start')}</p>
          <a href="/app/log?tab=period" class="mt-4">
            <Button size="sm" className="text-xs font-semibold shadow-xs">
              {translate('calendar.mark_period_date')}
            </Button>
          </a>
        </CardContent>
      </Card>
    )}

    {/* Medical & Privacy Guarantee Card */}
    <Card className="border-border/70 bg-muted/20 shadow-none">
      <CardContent className="p-4 space-y-1.5">
        <div class="flex items-center gap-1.5 text-xs font-bold text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round" class="text-sage">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>Private Rhythm Intelligence</span>
        </div>
        <p class="text-[11px] text-muted-foreground/80 leading-relaxed">
          {translate('predictions.disclaimer')}
        </p>
      </CardContent>
    </Card>

    {periodLogs.length > 0 && (
      <form method="POST" class="pt-1">
        <input type="hidden" name="_csrf" value={csrfToken} />
        <Button type="submit" variant="outline" className="w-full h-11 text-xs font-semibold shadow-2xs">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67" />
          </svg>
          {translate('predictions.recompute_btn')}
        </Button>
      </form>
    )}
  </div>
</AppShell>


