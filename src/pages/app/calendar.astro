---
import AppShell from '@/layouts/AppShell.astro';
import { InteractiveCalendar } from '@/components/app/interactive-calendar';
import { findPeriodLogs, findLatestPrediction } from '@/lib/db/client';
import { listDailyStatusLogs } from '@/lib/modules/cycles/repository';
import { todayIso } from '@/lib/utils/dates';
import { translate } from '@/lib/i18n/use-translation';

export const prerender = false;

const user = Astro.locals.user!;
const periodLogs = await findPeriodLogs(user.id);
const dailyLogs = await listDailyStatusLogs(user.id);
const prediction = await findLatestPrediction(user.id);
const today = todayIso();

const predictionData = prediction ? {
  predictedNextPeriodDate: prediction.predicted_next_period_date,
  predictedOvulationDate: prediction.predicted_ovulation_date,
  predictedFertileStart: prediction.predicted_fertile_start,
  predictedFertileEnd: prediction.predicted_fertile_end,
  averageCycleLength: prediction.average_cycle_length_used,
} : null;
---

<AppShell title="Calendar" activeRoute="calendar" headerTitle={translate('nav.calendar')} headerSubtitle="Monthly cycle rhythm at a glance">
  <div class="p-4 pb-10">
    <InteractiveCalendar
      today={today}
      periodLogs={periodLogs}
      dailyLogs={dailyLogs}
      prediction={predictionData}
      client:load
    />
  </div>
</AppShell>


