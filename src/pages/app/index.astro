---
import AppShell from '@/layouts/AppShell.astro';
import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { CycleRing } from '@/components/app/cycle-ring';
import { PhaseTimeline } from '@/components/app/phase-timeline';
import { QuickLogCard } from '@/components/app/quick-log-card';
import { UpcomingEvents } from '@/components/app/upcoming-events';
import { findLatestPrediction, findPeriodLogs } from '@/lib/db/client';
import { listDailyStatusLogs } from '@/lib/modules/cycles/repository';
import { todayIso, daysBetween } from '@/lib/utils/dates';
import { translate } from '@/lib/i18n/use-translation';

export const prerender = false;

const user = Astro.locals.user!;
const prediction = await findLatestPrediction(user.id);
const periodLogs = await findPeriodLogs(user.id);
const dailyLogs = await listDailyStatusLogs(user.id);

const lastPeriod = periodLogs[periodLogs.length - 1];
const today = todayIso();

// Cycle day calculation
let cycleDay = 0;
if (lastPeriod) {
  cycleDay = Math.max(1, daysBetween(lastPeriod.start_date, today) + 1);
}

// Check if currently in period using actual period log end_date
let isInPeriod = false;
let periodDay: number | null = null;
if (lastPeriod) {
  const daysSinceStart = daysBetween(lastPeriod.start_date, today);
  isInPeriod = daysSinceStart >= 0 && today <= lastPeriod.end_date;
  if (isInPeriod) {
    periodDay = daysSinceStart + 1;
  }
}

// Average cycle length
let avgCycleLength: number | null = null;
if (periodLogs.length >= 2) {
  const totalCycleLen = daysBetween(periodLogs[0].start_date, lastPeriod.start_date);
  avgCycleLength = Math.round(totalCycleLen / (periodLogs.length - 1));
}

// Today's status
const recentStatus = dailyLogs[0];
const hasLoggedToday = recentStatus?.log_date === today;

// Greeting based on time of day
const hour = new Date().getHours();
let greetingKey = 'home.good_morning';
if (hour >= 12 && hour < 17) greetingKey = 'home.good_afternoon';
else if (hour >= 17) greetingKey = 'home.good_evening';

const displayName = user.email?.split('@')[0] ?? 'there';
---

<AppShell title="Dashboard" activeRoute="home">
  <div class="space-y-4 p-4 pb-6 select-none">

    {/* ===== Cycle Ring Hero ===== */}
    {cycleDay > 0 ? (
      <div class="relative overflow-hidden rounded-3xl border border-border/80 bg-gradient-to-b from-card via-card to-muted/30 p-5 shadow-sm shadow-stone-900/5">
        <div class="flex flex-col items-center">
          <CycleRing
            cycleDay={cycleDay}
            avgCycleLength={avgCycleLength}
            nextPeriodDate={prediction?.predicted_next_period_date ?? null}
            isInPeriod={isInPeriod}
            periodDay={periodDay}
            client:load
          />
        </div>
      </div>
    ) : (
      <div class="relative overflow-hidden rounded-3xl border border-border/80 bg-card p-8 text-center shadow-sm shadow-stone-900/5">
        <div class="mx-auto mb-3.5 flex h-14 w-14 items-center justify-center rounded-2xl border border-primary/25 bg-primary/10 text-primary shadow-xs">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 3a9 9 0 0 1 0 18v-18z" fill="currentColor" fill-opacity="0.25" />
          </svg>
        </div>
        <h2 class="text-lg font-bold text-foreground tracking-tight mb-1">
          {translate(greetingKey as any)}, {displayName}
        </h2>
        <p class="text-xs text-muted-foreground max-w-xs mx-auto leading-relaxed">
          {translate('home.log_first_period')}
        </p>
      </div>
    )}

    {/* ===== Quick Actions ===== */}
    <div class="grid grid-cols-2 gap-3">
      <a href="/app/log?tab=period" class="block group">
        <div class="flex items-center justify-center gap-2 h-12 rounded-2xl bg-primary text-primary-foreground font-semibold text-xs shadow-sm shadow-primary/25 group-hover:brightness-105 group-active:scale-[0.98] transition-all relative overflow-hidden before:absolute before:inset-x-0 before:top-0 before:h-[1px] before:bg-white/25">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          <span>{translate('home.log_period')}</span>
        </div>
      </a>
      <a href="/app/log?tab=status" class="block group">
        <div class="flex items-center justify-center gap-2 h-12 rounded-2xl border border-border/80 bg-card text-foreground font-semibold text-xs shadow-2xs group-hover:bg-muted/70 group-active:scale-[0.98] transition-all relative before:absolute before:inset-x-0 before:top-0 before:h-[1px] before:bg-white/60 dark:before:bg-white/5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
            <path d="M12 20h9"/>
            <path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>
          </svg>
          <span>{translate('home.daily_status')}</span>
        </div>
      </a>
    </div>

    {/* ===== Phase Timeline ===== */}
    {cycleDay > 0 && (
      <Card>
        <CardHeader className="p-5 pb-2">
          <CardTitle className="text-sm font-semibold tracking-tight">{translate('home.your_cycle')}</CardTitle>
        </CardHeader>
        <CardContent className="p-5 pt-1">
          <PhaseTimeline
            avgCycleLength={avgCycleLength}
            nextPeriodDate={prediction?.predicted_next_period_date ?? null}
            lastPeriodStart={lastPeriod!.start_date}
            avgPeriodLength={5}
            predictedOvulationDate={prediction?.predicted_ovulation_date ?? null}
            fertileStart={prediction?.predicted_fertile_start ?? null}
            fertileEnd={prediction?.predicted_fertile_end ?? null}
            client:load
          />
        </CardContent>
      </Card>
    )}

    {/* ===== Today's Log Card ===== */}
    <Card>
      <CardHeader className="p-5 pb-2">
        <div class="flex items-center justify-between">
          <CardTitle className="text-sm font-semibold tracking-tight">{translate('home.today')}</CardTitle>
          <span class="text-[11px] font-semibold text-muted-foreground">
            {new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })}
          </span>
        </div>
      </CardHeader>
      <CardContent className="p-5 pt-1">
        <QuickLogCard hasLoggedToday={hasLoggedToday} todayStatus={recentStatus ?? null} />
        {hasLoggedToday && (
          <a href="/app/log" class="mt-3.5 block">
            <Button variant="outline" className="w-full h-8 text-xs font-semibold" size="sm">
              {translate('home.update_today')}
            </Button>
          </a>
        )}
      </CardContent>
    </Card>

    {/* ===== Upcoming Events ===== */}
    <Card>
      <CardHeader className="p-5 pb-2">
        <CardTitle className="text-sm font-semibold tracking-tight">{translate('home.upcoming')}</CardTitle>
      </CardHeader>
      <CardContent className="p-5 pt-1">
        <UpcomingEvents
          nextPeriodDate={prediction?.predicted_next_period_date ?? null}
          predictedOvulationDate={prediction?.predicted_ovulation_date ?? null}
          fertileStart={prediction?.predicted_fertile_start ?? null}
          fertileEnd={prediction?.predicted_fertile_end ?? null}
          confidenceBand={prediction?.confidence_band ?? null}
          client:load
        />
      </CardContent>
    </Card>

    {/* ===== Stats Telemetry ===== */}
    {periodLogs.length > 0 && (
      <div class="grid grid-cols-3 gap-2.5">
        <div class="flex flex-col items-center justify-center rounded-2xl bg-card border border-border/80 p-3.5 shadow-2xs">
          <span class="text-[10px] font-semibold text-muted-foreground/80 uppercase tracking-wider">{translate('home.periods_tracked')}</span>
          <span class="text-xl font-bold text-primary mt-0.5 tabular-nums">{periodLogs.length}</span>
        </div>
        <div class="flex flex-col items-center justify-center rounded-2xl bg-card border border-border/80 p-3.5 shadow-2xs">
          <span class="text-[10px] font-semibold text-muted-foreground/80 uppercase tracking-wider">{translate('home.avg_cycle')}</span>
          <span class="text-xl font-bold text-foreground mt-0.5 tabular-nums">{avgCycleLength ? `${avgCycleLength}d` : '-'}</span>
        </div>
        <div class="flex flex-col items-center justify-center rounded-2xl bg-card border border-border/80 p-3.5 shadow-2xs">
          <span class="text-[10px] font-semibold text-muted-foreground/80 uppercase tracking-wider">{translate('home.daily_logs')}</span>
          <span class="text-xl font-bold text-foreground mt-0.5 tabular-nums">{dailyLogs.length}</span>
        </div>
      </div>
    )}

  </div>
</AppShell>

