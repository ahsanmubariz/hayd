---
import AdminShell from '@/layouts/AdminShell.astro';
import { Card } from '@/components/ui/card';
import { UserTable } from '@/components/admin/user-table';
import { listUsers } from '@/lib/modules/users/repository';

export const prerender = false;

const url = new URL(Astro.request.url);
const search = url.searchParams.get('search') ?? '';
const status = url.searchParams.get('status') ?? '';

let users = await listUsers();
if (search) {
  const q = search.toLowerCase();
  users = users.filter((u) => u.email.toLowerCase().includes(q));
}
if (status) {
  users = users.filter((u) => u.status === status);
}
---

<AdminShell title="Users" activeRoute="users">
  <div class="space-y-5 select-none">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <h1 class="text-xl font-bold text-foreground tracking-tight">User Directory</h1>
        <p class="text-xs text-muted-foreground mt-0.5">{users.length} user{users.length !== 1 ? 's' : ''} registered in sanctuary</p>
      </div>
      <a href="/admin/users/new" class="inline-flex items-center gap-1.5 rounded-2xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow-xs hover:brightness-105 active:scale-[0.98] transition-all shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        Add user
      </a>
    </div>

    <!-- Search & filter -->
    <form method="GET" action="/admin/users">
      <Card className="p-4">
        <div class="flex flex-col sm:flex-row gap-3">
          <div class="flex-1">
            <label for="search" class="mb-1.5 block text-xs font-semibold text-foreground">Search</label>
            <input
              type="text"
              id="search"
              name="search"
              placeholder="Search by email..."
              value={search}
              class="h-10 w-full rounded-2xl border border-border bg-card px-3.5 text-xs text-foreground placeholder:text-muted-foreground/60 focus:outline-none focus:ring-2 focus:ring-ring shadow-2xs"
            />
          </div>
          <div class="sm:w-44">
            <label for="status" class="mb-1.5 block text-xs font-semibold text-foreground">Status</label>
            <select
              id="status"
              name="status"
              value={status}
              class="h-10 w-full rounded-2xl border border-border bg-card px-3.5 text-xs text-foreground focus:outline-none focus:ring-2 focus:ring-ring shadow-2xs cursor-pointer"
            >
              <option value="">All statuses</option>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
              <option value="deleted">Deleted</option>
            </select>
          </div>
          <div class="flex items-end">
            <button
              type="submit"
              class="h-10 rounded-2xl bg-primary px-5 text-xs font-semibold text-primary-foreground shadow-xs hover:brightness-105 active:scale-[0.98] transition-all"
            >
              Filter
            </button>
          </div>
        </div>
      </Card>
    </form>

    <UserTable
      users={users}
      viewHrefPrefix="/admin/users"
      client:load
    />
  </div>
</AdminShell>

