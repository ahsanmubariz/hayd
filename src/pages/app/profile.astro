---
import AppShell from '@/layouts/AppShell.astro';
import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/card';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';
import { Alert } from '@/components/ui/alert';
import { PrivacyCard } from '@/components/app/privacy-card';
import { findProfile, findPasskeysByUser, findPasskeyById, deletePasskey } from '@/lib/db/client';
import { updateUserProfile, changePassword } from '@/lib/modules/users/service';
import { translate } from '@/lib/i18n/use-translation';
import { getCsrfToken, validateCsrf } from '@/lib/auth/csrf';

export const prerender = false;

const csrfToken = getCsrfToken(Astro);

const user = Astro.locals.user!;
const profile = await findProfile(user.id);
const passkeys = await findPasskeysByUser(user.id);

let success = '';
let errors: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  if (!validateCsrf(Astro, Astro.request, formData)) {
    errors = { form: 'Invalid request. Please try again.' };
  } else {
    const action = String(formData.get('action') ?? '');

    try {
      if (action === 'profile') {
        await updateUserProfile(user.id, {
          displayName: String(formData.get('displayName') ?? ''),
          timezone: String(formData.get('timezone') ?? 'Asia/Jakarta'),
        });
        success = translate('profile.profile_updated');
      } else if (action === 'password') {
        await changePassword(user.id, {
          currentPassword: String(formData.get('currentPassword') ?? ''),
          newPassword: String(formData.get('newPassword') ?? ''),
        });
        success = translate('profile.password_updated');
      } else if (action === 'delete-passkey') {
        const passkeyId = String(formData.get('passkeyId') ?? '');
        if (passkeyId) {
          const pk = await findPasskeyById(passkeyId);
          if (pk && pk.user_id === user.id) {
            await deletePasskey(passkeyId);
            success = 'Passkey deleted successfully';
          }
        }
      }
    } catch (err) {
      if (err && typeof err === 'object' && 'fieldErrors' in err) {
        errors = (err as { fieldErrors: Record<string, string> }).fieldErrors;
      }
    }
  }
}
---

<AppShell title="Profile" activeRoute="profile" headerTitle={translate('nav.profile')} headerSubtitle={translate('profile.manage_account')}>
  <div class="space-y-4 p-4 pb-10">
    {success && <Alert variant="success">{success}</Alert>}
    {errors.form && <Alert variant="error">{errors.form}</Alert>}

    {/* Account Identity Card */}
    <Card className="border-border/80 bg-gradient-to-b from-card to-muted/20 shadow-xs">
      <CardContent className="p-5">
        <div class="flex items-center gap-3.5">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-primary/20 bg-primary/10 text-lg font-bold text-primary shadow-xs">
            {user.email.charAt(0).toUpperCase()}
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-bold text-foreground tracking-tight truncate">{profile?.display_name || user.email.split('@')[0]}</p>
            <p class="text-xs text-muted-foreground truncate">{user.email}</p>
            <div class="flex items-center gap-2 mt-1 text-[11px] text-muted-foreground">
              <span class="inline-flex items-center rounded-full bg-primary/10 px-2 py-0.5 font-medium text-primary capitalize border border-primary/20">{user.role}</span>
              <span>·</span>
              <span>{translate('profile.member_since')} {new Date().toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
            </div>
          </div>
        </div>
      </CardContent>
    </Card>

    {/* Profile Form */}
    <form method="POST">
      <input type="hidden" name="action" value="profile" />
      <input type="hidden" name="_csrf" value={csrfToken} />
      <Card>
        <CardHeader className="p-5 pb-2">
          <CardTitle className="text-sm font-semibold tracking-tight">{translate('profile.personal_info')}</CardTitle>
        </CardHeader>
        <CardContent className="p-5 pt-1 space-y-3">
          <Input
            name="displayName"
            label={translate('profile.display_name')}
            placeholder={translate('profile.display_name_placeholder')}
            defaultValue={profile?.display_name ?? ''}
            error={errors.displayName}
          />
          <Input
            name="timezone"
            label={translate('profile.timezone')}
            defaultValue={profile?.timezone ?? 'Asia/Jakarta'}
            error={errors.timezone}
          />
          <Button type="submit" variant="outline" className="w-full h-10 text-xs font-semibold">{translate('profile.save_profile')}</Button>
        </CardContent>
      </Card>
    </form>

    {/* Password Form */}
    <form method="POST">
      <input type="hidden" name="action" value="password" />
      <input type="hidden" name="_csrf" value={csrfToken} />
      <Card>
        <CardHeader className="p-5 pb-2">
          <CardTitle className="text-sm font-semibold tracking-tight">{translate('profile.change_password')}</CardTitle>
        </CardHeader>
        <CardContent className="p-5 pt-1 space-y-3">
          <Input
            type="password"
            name="currentPassword"
            label={translate('profile.current_password')}
            autoComplete="current-password"
            error={errors.currentPassword}
          />
          <Input
            type="password"
            name="newPassword"
            label={translate('profile.new_password')}
            autoComplete="new-password"
            error={errors.newPassword}
          />
          <Button type="submit" variant="outline" className="w-full h-10 text-xs font-semibold">{translate('profile.update_password')}</Button>
        </CardContent>
      </Card>
    </form>

    {/* Passkeys Card */}
    <Card>
      <CardHeader className="p-5 pb-2">
        <div className="flex items-center gap-2">
          <div className="flex h-6 w-6 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M21 2l-2 2m-1.5 1.5L14 9l-1.5-1.5" />
              <circle cx="7.5" cy="15.5" r="5.5" />
            </svg>
          </div>
          <CardTitle className="text-sm font-semibold tracking-tight">Passkeys (WebAuthn)</CardTitle>
        </div>
      </CardHeader>
      <CardContent className="p-5 pt-1 space-y-3">
        <p className="text-xs text-muted-foreground leading-relaxed">
          Sign in instantly using biometrics (Touch ID, Face ID), security keys, or device PIN.
        </p>

        {passkeys.length > 0 ? (
          <div class="divide-y divide-border/60 rounded-2xl border border-border/80 bg-muted/20">
            {passkeys.map((pk) => (
              <div class="flex items-center justify-between p-3 text-xs">
                <div class="min-w-0 pr-2">
                  <div class="flex items-center gap-1.5">
                    <span class="h-1.5 w-1.5 rounded-full bg-sage" />
                    <p class="font-semibold text-foreground">Passkey Credential</p>
                  </div>
                  <p class="text-muted-foreground text-[10px] font-mono mt-0.5">
                    ID: {pk.id.substring(0, 8)}...{pk.id.substring(pk.id.length - 8)}
                  </p>
                  <p class="text-[10px] text-muted-foreground">
                    Added: {new Date(pk.created_at).toLocaleDateString()}
                  </p>
                </div>
                <form method="POST" style="display:inline">
                  <input type="hidden" name="action" value="delete-passkey" />
                  <input type="hidden" name="passkeyId" value={pk.id} />
                  <input type="hidden" name="_csrf" value={csrfToken} />
                  <Button type="submit" variant="destructive" size="sm" className="h-7 px-2.5 text-[10px]">
                    Delete
                  </Button>
                </form>
              </div>
            ))}
          </div>
        ) : (
          <p className="text-xs text-muted-foreground italic bg-muted/30 p-3 rounded-xl border border-border/40 text-center">No passkeys registered yet.</p>
        )}

        <Button id="register-passkey-btn" type="button" variant="outline" className="w-full h-10 text-xs font-semibold shadow-xs">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          Register New Passkey
        </Button>
        <div id="passkey-error" class="hidden text-xs text-destructive p-2 rounded-xl bg-destructive/10 border border-destructive/20 text-center"></div>
      </CardContent>
    </Card>

    {/* Privacy Sanctuary */}
    <PrivacyCard client:load />

    {/* Sign out */}
    <Card className="border-border/60">
      <CardContent className="p-3">
        <a href="/logout">
          <Button variant="ghost" className="w-full h-9 text-xs font-semibold text-destructive hover:bg-destructive/10" size="sm">
            {translate('profile.sign_out')}
          </Button>
        </a>
      </CardContent>
    </Card>
  </div>
</AppShell>

<script>
  import { startRegistration } from '@simplewebauthn/browser';

  const registerBtn = document.getElementById('register-passkey-btn');
  const errorDiv = document.getElementById('passkey-error');

  if (registerBtn) {
    registerBtn.addEventListener('click', async () => {
      if (errorDiv) {
        errorDiv.classList.add('hidden');
        errorDiv.textContent = '';
      }
      registerBtn.disabled = true;
      const originalText = registerBtn.textContent;
      registerBtn.textContent = 'Registering...';

      try {
        // 1. Get options from server
        const optionsRes = await fetch('/api/passkey/register/options');
        if (!optionsRes.ok) {
          throw new Error('Failed to get registration options');
        }
        const options = await optionsRes.json();

        // 2. Start registration in browser
        const credential = await startRegistration({ optionsJSON: options });

        // 3. Verify on server
        const verifyRes = await fetch('/api/passkey/register/verify', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(credential),
        });

        const verifyResult = await verifyRes.json();
        if (!verifyRes.ok || !verifyResult.verified) {
          throw new Error(verifyResult.error || 'Verification failed');
        }

        // 4. Reload page on success
        window.location.reload();
      } catch (err: any) {
        console.error(err);
        if (errorDiv) {
          errorDiv.textContent = err.message || 'An error occurred during passkey registration.';
          errorDiv.classList.remove('hidden');
        }
        registerBtn.disabled = false;
        registerBtn.textContent = originalText;
      }
    });
  }
</script>
