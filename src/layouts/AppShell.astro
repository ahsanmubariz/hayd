---
import '@/styles/app.css';
import { Header } from '@/components/ui/header';
import { BottomNav } from '@/components/ui/bottom-nav';
import { ThemeToggle } from '@/components/ui/theme-toggle';
import { LangToggle } from '@/components/ui/lang-toggle';
import { PwaPrompt } from '@/components/app/pwa-prompt';
import { translate, setLang } from '@/lib/i18n/use-translation';
import type { Lang } from '@/lib/i18n/translations';

interface Props {
  title?: string;
  activeRoute?: 'home' | 'calendar' | 'log' | 'predictions' | 'profile';
  headerTitle?: string;
  headerSubtitle?: string;
  showBack?: boolean;
  backHref?: string;
}

const { title = 'Hayd', activeRoute = 'home', headerTitle, headerSubtitle, showBack, backHref } = Astro.props;

// Set language from cookie for SSR
const cookieLang = Astro.cookies.get('hayd-lang')?.value;
if (cookieLang === 'id' || cookieLang === 'en') {
  setLang(cookieLang as Lang);
}

const user = Astro.locals.user;
const navItems = [
  { href: '/app', label: translate('nav.home'), icon: 'home', active: activeRoute === 'home' },
  { href: '/app/calendar', label: translate('nav.calendar'), icon: 'calendar', active: activeRoute === 'calendar' },
  { href: '/app/log', label: translate('nav.log'), icon: 'log', active: activeRoute === 'log' },
  { href: '/app/predictions', label: translate('nav.predictions'), icon: 'predictions', active: activeRoute === 'predictions' },
  { href: '/app/profile', label: translate('nav.profile'), icon: 'profile', active: activeRoute === 'profile' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title} · Hayd</title>
    <style is:inline>
      *,*::before,*::after{box-sizing:border-box}
      .hidden{display:none!important}
    </style>
    <script is:inline>
      (function() {
        var t = localStorage.getItem('hayd-theme');
        var dark = t === 'dark' || (t === null && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        var l = localStorage.getItem('hayd-lang') || 'id';
        document.documentElement.lang = l;
        document.cookie = 'hayd-lang=' + l + ';path=/;max-age=31536000';
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased selection:bg-primary selection:text-primary-foreground">
    <!--
    THESIS: A private, dignified sanctuary for cycle tracking that refuses generic pink gamification and sterile clinical spreadsheets.
    OWN-WORLD: Glazed ceramic porcelain and smoked obsidian tea-room surfaces, celadon sage, earthy vermilion lacquer, and fine hairline details.
    STORY: Users log intimate wellness metrics effortlessly in seconds and discover calm, trustworthy predictions.
    FIRST VIEWPORT: Organic lunar cycle disc with layered phase rings, immediate today status, and tactile quick logging.
    FORM: Japanese Ceramic Sanctuary / Lunar Rhythm (Candidate 3, seed 575c66bc).
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <div class="relative min-h-screen pb-24">
      <Header
        title={headerTitle ?? (activeRoute === 'home' ? `${translate('nav.greeting')}, ${user?.email?.split('@')[0] ?? translate('nav.there')}` : title)}
        subtitle={headerSubtitle}
        userEmail={user?.email}
        showBack={showBack}
        backHref={backHref}
      />
      <main class="mx-auto max-w-lg">
        <slot />
      </main>
    </div>

    <!-- Floating Theme & Language Utility Pill -->
    <div class="fixed top-3 right-4 z-40 flex items-center gap-1 rounded-full border border-border/80 bg-card/85 p-1 shadow-sm shadow-stone-900/5 backdrop-blur-md">
      <LangToggle client:load />
      <ThemeToggle client:load />
    </div>

    <!-- Floating Curved Bottom Navigation -->
    <BottomNav items={navItems} client:load />
    <PwaPrompt client:load />
  </body>
</html>
