---
import AdminShell from '@/layouts/AdminShell.astro';
import { AuditTable } from '@/components/admin/audit-table';
import { listAuditLogs } from '@/lib/modules/audit/service';

export const prerender = false;

const logs = await listAuditLogs(100);
---

<AdminShell title="Audit logs" activeRoute="audit">
  <div class="space-y-4 select-none">
    <div>
      <h1 class="text-xl font-bold text-foreground tracking-tight">Audit Logs</h1>
      <p class="text-xs text-muted-foreground mt-0.5">
        Append-only record of admin operations. Health note contents and sensitive personal data are never logged.
      </p>
    </div>
    <AuditTable logs={logs} />
  </div>
</AdminShell>

